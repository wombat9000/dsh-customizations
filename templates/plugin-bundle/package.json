{
  "name": "@your-scope/dsh-example",
  "version": "0.1.0",
  "private": true,
  "description": "Example installable DSH plugin bundle",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "src/**/*.js"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2"
  }
}
