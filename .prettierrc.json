{
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "overrides": [
    {
      "files": "**/*.md.template",
      "options": { "parser": "markdown" }
    }
  ]
}
