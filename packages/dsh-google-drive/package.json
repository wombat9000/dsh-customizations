{
  "name": "@local/dsh-google-drive",
  "version": "0.1.0",
  "private": true,
  "description": "Session-scoped Google Drive read permissions, picker, tools and skills for DSH 0.1.2-rc.1",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["src", "client.js", "presets", "cordis.patch.yml", "README.md"],
  "scripts": { "test": "node --test test/*.test.js" },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "inject": ["@deepseek-ai/dsh-client-ui-tool", "@deepseek-ai/dsh-client-ui-layout"], "platform": "web" }
  },
  "license": "UNLICENSED"
}
