{
  "name": "@local/dsh-google-drive",
  "version": "0.1.1",
  "private": true,
  "description": "Session-scoped Drive reading and Google Sheets previews with approved edits for DSH 0.2.0-rc.2",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./tools": "./dist/src/tools.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs/pdf-runtime.md",
    "docs/sheets.md"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.host.json && node scripts/typecheck-client.mjs",
    "typecheck:host": "node ../../node_modules/typescript/bin/tsc -p tsconfig.host.json",
    "typecheck:client": "node scripts/typecheck-client.mjs",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2"
  }
}
