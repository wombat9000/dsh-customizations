{
  "name": "@local/dsh-jev",
  "version": "0.1.0",
  "private": true,
  "description": "Host-only Jev structured decisions through shared OpenRouter credentials",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./src/runtime.js": {
      "types": "./src/runtime.ts",
      "default": "./dist/src/runtime.js"
    },
    "./shared/contracts": {
      "types": "./shared/contracts.ts",
      "default": "./dist/shared/contracts.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "src/**/*.ts",
    "shared/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "client.js",
    "scripts/*.mjs",
    "tsconfig*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-rc.2",
    "react": "18.3.1"
  },
  "license": "UNLICENSED",
  "types": "src/index.ts"
}
