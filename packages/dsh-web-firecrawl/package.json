{
  "name": "@local/dsh-web-firecrawl",
  "version": "0.1.5",
  "private": true,
  "description": "Firecrawl search and fetch provider bundle for DSH 0.2.1-rc.5",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/index.test.js test/client.test.js",
    "test:integration": "node --test test/profile.integration.test.js",
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.5",
    "@deepseek-ai/dsh-web": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.5",
    "react": "18.3.1"
  },
  "license": "UNLICENSED"
}
