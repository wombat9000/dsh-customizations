{
  "name": "@local/dsh-tool-trivy",
  "version": "0.1.0",
  "private": true,
  "description": "Pre-installed Trivy vulnerability-audit tool and bundled skill for DSH",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "client.js",
    "cordis.patch.yml",
    "dist/**/*.js"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/profile.integration.test.js",
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "react": "18.3.1"
  },
  "license": "UNLICENSED"
}
