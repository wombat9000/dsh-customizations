{
  "name": "@local/dsh-tool-imagegen",
  "version": "0.1.0",
  "private": true,
  "description": "Gemini image generation tool for DSH",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./src/index.js": "./dist/src/index.js",
    "./src/gemini.js": "./dist/src/gemini.js"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "dist/**/*.js",
    "README.md",
    "src/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "shared/**/*.ts",
    "scripts/*.mjs",
    "tsconfig*.json"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/profile.integration.test.js",
    "test:browser": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.mjs --configLoader native"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@google/genai": "2.21.0",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "react": "18.3.1"
  },
  "license": "UNLICENSED"
}
