{
  "name": "@local/dsh-github",
  "version": "0.1.0",
  "private": true,
  "description": "Preset-neutral GitHub tools with exact approvals and session-scoped issue grants",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./runtime": {
      "types": "./dist/src/runtime.d.ts",
      "default": "./dist/src/runtime.js"
    },
    "./reads": {
      "types": "./dist/src/reads.d.ts",
      "default": "./dist/src/reads.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "client/**/*.ts",
    "client/**/*.tsx",
    "shared/**/*.ts",
    "scripts/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/**/*.ts",
    "tsconfig*.json"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "build:host": "node scripts/build-host.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "UNLICENSED"
}
