{
  "name": "@local/dsh-github",
  "version": "0.1.0",
  "private": true,
  "description": "Preset-neutral GitHub tools with exact approvals and session-scoped issue grants",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "client.js",
    "client/**/*.ts",
    "client/**/*.tsx",
    "shared/**/*.ts",
    "scripts/*.mjs",
    "tsconfig.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "UNLICENSED"
}
