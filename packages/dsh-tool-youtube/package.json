{
  "name": "@local/dsh-tool-youtube",
  "version": "0.1.1",
  "private": true,
  "description": "Gemini-backed YouTube video tools for DSH",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./client.js",
    "./transcript-store": "./dist/src/transcript-store.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "dist/**/*.js",
    "README.md",
    "src/**/*.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "scripts/*.mjs",
    "tsconfig*.json"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/typecheck.mjs && node --test test/*.test.js",
    "test:integration": "node --test test/profile.integration.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@google/genai": "2.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "react": "18.3.1"
  },
  "license": "UNLICENSED"
}
