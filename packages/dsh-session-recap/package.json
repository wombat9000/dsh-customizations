{
  "name": "@wombat9000/dsh-session-recap",
  "version": "0.1.0",
  "private": true,
  "description": "Return-to-session recaps with an instance-configured model for DSH Web",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["client.js", "cordis.patch.yml", "src/**/*.js", "README.md"],
  "scripts": {"test": "node --test test/*.test.*"},
  "engines": {"node": "^22.19.0 || >=24.0.0"},
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.1",
    "react": "18.3.1"
  },
  "license": "UNLICENSED"
}
