{
  "name": "@wombat9000/dsh-session-recap",
  "version": "0.1.1",
  "private": true,
  "description": "Return-to-session recaps with an instance-configured model for DSH Web",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "client.js",
    "client/**/*.ts",
    "client/**/*.tsx",
    "shared/**/*.ts",
    "scripts/*.mjs",
    "tsconfig.json",
    "cordis.patch.yml",
    "src/**/*.ts",
    "dist/**/*.js",
    "tsconfig.host.json",
    "README.md"
  ],
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.*"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.0-rc.2",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2"
  },
  "license": "UNLICENSED"
}
