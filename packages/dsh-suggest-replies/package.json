{
  "name": "@local/dsh-suggest-replies",
  "version": "0.1.1",
  "private": true,
  "description": "Agent-authored follow-up replies above the DSH composer",
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./client.js",
    "./locale/en.json": "./locale/en.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "locale",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build-host.mjs && node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "react": "18.3.1"
  },
  "license": "UNLICENSED"
}
