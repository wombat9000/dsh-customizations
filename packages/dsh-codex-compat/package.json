{
  "name": "@local/dsh-codex-compat",
  "version": "0.1.8",
  "private": true,
  "description": "Repository-owned Codex sign-in and independently controlled Fast compatibility for DSH 0.2.2-rc.5",
  "type": "module",
  "exports": {
    ".": "./dist/src/fast/index.js",
    "./oauth": "./dist/src/oauth/index.js",
    "./fast": "./dist/src/fast/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "oauth/index.js",
    "oauth/client.js",
    "oauth/package.json"
  ],
  "scripts": {
    "build": "node ../../scripts/build.mjs dsh-codex-compat",
    "typecheck": "node ../../scripts/build.mjs --typecheck dsh-codex-compat",
    "test": "node ../../scripts/build.mjs --typecheck dsh-codex-compat && node --test test/*.test.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-settings": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "react": "18.3.1"
  },
  "license": "UNLICENSED"
}
