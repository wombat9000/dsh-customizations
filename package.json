{
  "name": "dsh-customizations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "apply": "node scripts/apply-profile.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test packages/dsh-session-recap/test/*.test.*",
    "test:browser": "vitest run --config vitest.browser.config.mjs",
    "test:browser:update": "vitest run --config vitest.browser.config.mjs --update"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.0",
    "playwright": "1.62.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "5.0.0"
  }
}
