{
  "name": "dsh-customizations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "apply": "node scripts/apply-profile.mjs",
    "check": "node scripts/check.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --typecheck",
    "pretest": "pnpm run build",
    "test": "node --test scripts/*.test.mjs packages/*/test/*.test.js packages/*/test/*.test.mjs tests/real-ui/*.test.mjs",
    "test:browser": "vitest run --config vitest.browser.config.mjs",
    "test:visual": "playwright test && playwright test --config packages/dsh-codex-compat/test/playwright.config.mjs && playwright test --config packages/dsh-dispatch/test/playwright.config.mjs",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.1",
    "@types/react": "18.3.28",
    "@vitest/browser-playwright": "5.0.0",
    "playwright": "1.62.0",
    "prettier": "3.9.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}
